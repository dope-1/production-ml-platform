aws_region   = "ap-south-1"
image_digest = "sha256:replace-with-64-lowercase-hex-characters-after-first-push"

# First apply with false. Populate ECR, S3 and both secrets before changing to true.
deploy_service = false

# Optional but strongly recommended. Alerts do not stop spending.
budget_email       = "owner@example.com"
monthly_budget_usd = 5
