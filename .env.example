# Copy to .env; replace the placeholder with a randomly generated password.
ML_ENVIRONMENT=development
ML_LOG_LEVEL=INFO
ML_DB_HOST=localhost
ML_DB_PORT=5432
ML_DB_NAME=ml_platform
ML_DB_USER=ml_platform
ML_DB_PASSWORD=
ML_DB_SSLMODE=prefer
ML_CORS_ORIGINS=[]

# upgrade_milestone9.py creates missing keys without printing them.
ML_AUTH_ENABLED=true
ML_API_KEY=
ML_ADMIN_KEY=
# Docker overrides these for its internal network and read-only controller mount.
ML_INFERENCE_ENABLED=false
ML_TRACKING_URI=http://127.0.0.1:5000
ML_MODEL_NAME=credit-default
ML_CONTROL_DIR=.state/registry

# One worker; each shared key has a shared quota, anonymous clients use their socket IP.
ML_RATE_LIMIT_PER_MINUTE=600
ML_ANONYMOUS_RATE_LIMIT_PER_MINUTE=60
ML_MAX_REQUEST_BYTES=1048576
ML_REQUEST_BODY_TIMEOUT_SECONDS=10
ML_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# In a managed deployment use ML_DB_PASSWORD_FILE, ML_API_KEY_FILE and
# ML_ADMIN_KEY_FILE with mounted secret files, instead of the corresponding values.
